          },
          {
            "name": "Popust (%)",
            "dataType": "double",
            "sourceColumn": "Popust (%)",
            "summarizeBy": "average",
            "formatString": "0.0"
          },
          {
            "name": "Vrednost stavke",
            "dataType": "decimal",
            "sourceColumn": "Vrednost stavke",
            "summarizeBy": "sum",
            "formatString": "#,##0.00"
          }
        ],
        "partitions": [
          {
            "name": "StavkeUgovora",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    SU = Tabela(\"STAVKA_UGOVORA\"),",
                "    UO = Tabela(\"UGOVOR_O_OGLASAVANJU\"),",
                "    S1 = Table.NestedJoin(SU, {\"BROJ_UGOVORA\"}, UO, {\"BROJ_UGOVORA\"},",
                "        \"uo\", JoinKind.Inner),",
                "    Odabir = Table.SelectColumns(S1, {\"BROJ_UGOVORA\", \"RB_STAVKE\", \"OPIS_STAVKE\", \"KOLICINA_SEKUNDE\", \"JEDINICNA_CENA\", \"POPUST\", \"VREDNOST_STAVKE\"}),",
                "    Izlaz = Table.RenameColumns(Odabir, {{\"BROJ_UGOVORA\", \"Broj ugovora\"}, {\"RB_STAVKE\", \"Rb stavke\"}, {\"OPIS_STAVKE\", \"Opis stavke\"}, {\"KOLICINA_SEKUNDE\", \"Ugovoreno sekundi\"}, {\"JEDINICNA_CENA\", \"Jedinična cena\"}, {\"POPUST\", \"Popust (%)\"}, {\"VREDNOST_STAVKE\", \"Vrednost stavke\"}})",
                "in",
                "    Izlaz"
              ]
            }
          }
        ],
        "description": "Izveštaj 6: ugovorene stavke (sekunde i vrednost).",
        "measures": [
          {
            "name": "Ugovoreno sekundi",
            "expression": [
              "SUM(StavkeUgovora[Ugovoreno sekundi])"
            ],
            "displayFolder": "Mere",
            "formatString": "#,##0"
          },
          {
            "name": "Ugovorena vrednost",
            "expression": [
              "SUM(StavkeUgovora[Vrednost stavke])"
            ],
            "displayFolder": "Mere",
            "formatString": "#,##0.00"
          },
          {
            "name": "Broj stavki ugovora",
            "expression": [
              "COUNTROWS(StavkeUgovora)"
            ],
            "displayFolder": "Mere",
            "formatString": "#,##0"
          }
        ]
      },
