          }
        ],
        "partitions": [
          {
            "name": "Gledanost",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    ME = Tabela(\"MERENJE_EMISIJE\"),",
                "    MG = Tabela(\"MERENJE_GLEDANOSTI\"),",
                "    S1 = Table.NestedJoin(ME, {\"SIFRA_MERENJA\"}, MG, {\"SIFRA_MERENJA\"},",
                "        \"mg\", JoinKind.Inner),",
                "    S2 = Table.ExpandTableColumn(S1, \"mg\", {\"DATUM_MERENJA\",",
                "        \"IZVOR_MERENJA\", \"CILJNA_GRUPA\", \"BROJ_GLEDALACA\",",
                "        \"PROSECNO_GLEDANJE\"}),",
                "    Odabir = Table.SelectColumns(S2, {\"SIFRA_MERENJA\", \"SIFRA_EMISIJE\", \"DATUM_MERENJA\", \"IZVOR_MERENJA\", \"CILJNA_GRUPA\", \"OSTVARENI_RATING\", \"UDEO_U_TERMINU\", \"BROJ_GLEDALACA\", \"PROSECNO_GLEDANJE\"}),",
                "    Izlaz = Table.RenameColumns(Odabir, {{\"SIFRA_MERENJA\", \"Šifra merenja\"}, {\"SIFRA_EMISIJE\", \"Šifra emisije\"}, {\"DATUM_MERENJA\", \"Datum merenja\"}, {\"IZVOR_MERENJA\", \"Izvor merenja\"}, {\"CILJNA_GRUPA\", \"Ciljna grupa\"}, {\"OSTVARENI_RATING\", \"Ostvareni rejting\"}, {\"UDEO_U_TERMINU\", \"Udeo u terminu\"}, {\"BROJ_GLEDALACA\", \"Broj gledalaca\"}, {\"PROSECNO_GLEDANJE\", \"Prosečno gledanje\"}})",
                "in",
                "    Izlaz"
              ]
            }
          }
        ],
        "description": "Izveštaj 3: merenja gledanosti po emisiji i žanru.",
        "measures": [
          {
            "name": "Broj merenja",
            "expression": [
              "COUNTROWS(Gledanost)"
            ],
            "displayFolder": "Mere",
            "formatString": "#,##0"
          },
          {
            "name": "Prosečan rejting",
            "expression": [
              "AVERAGE(Gledanost[Ostvareni rejting])"
            ],
            "displayFolder": "Mere",
            "formatString": "0.00"
          },
          {
            "name": "Prosečan udeo",
            "expression": [
              "AVERAGE(Gledanost[Udeo u terminu])"
            ],
            "displayFolder": "Mere",
            "formatString": "0.00"
          },
          {
            "name": "Prosečno gledalaca",
            "expression": [
              "AVERAGE(Gledanost[Broj gledalaca])"
            ],
            "displayFolder": "Mere",
            "formatString": "#,##0"
          },
          {
            "name": "Prosečno gledanje (min)",
            "expression": [
              "AVERAGE(Gledanost[Prosečno gledanje])"
            ],
            "displayFolder": "Mere",
            "formatString": "0.0"
          }
        ]
      },
      {
        "name": "Troskovi",
        "columns": [
          {
            "name": "Šifra projekta",
            "dataType": "string",
            "sourceColumn": "Šifra projekta",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Rb aktivnosti",
            "dataType": "int64",
            "sourceColumn": "Rb aktivnosti",
            "summarizeBy": "none"
