            "expression": [
              "SUM(EmitovanjaReklama[Naplaćeni iznos])"
            ],
            "displayFolder": "Mere",
            "formatString": "#,##0.00"
          },
          {
            "name": "Broj spotova",
            "expression": [
              "COUNTROWS(EmitovanjaReklama)"
            ],
            "displayFolder": "Mere",
            "formatString": "#,##0"
          }
        ]
