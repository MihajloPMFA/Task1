      {
        "name": "PutDoCsv",
        "kind": "m",
        "expression": "\"C:\\TV_Panorama\\csv\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Text"
          }
        ]
      },
      {
        "name": "Tipovi",
        "kind": "m",
        "expression": [
          "let",
          "    Tipovi = [",
          "        ZAPIS_O_EMITOVANJU = {{\"SIFRA_TERMINA\", type text}, {\"RB_EMITOVANJA\", Int64.Type}, {\"SIFRA_SADRZAJA\", type text}, {\"STATUS_REALIZACIJE\", type text}, {\"STVARNO_VREME_POCETKA\", type time}, {\"STVARNO_TRAJANJE\", Int64.Type}, {\"NAPOMENA_O_SMETNJAMA\", type text}, {\"OPERATER_EMITOVANJA\", type text}},",
          "        TERMIN_EMITOVANJA = {{\"SIFRA_TERMINA\", type text}, {\"SIFRA_SEME\", type text}, {\"RB_CELINE\", Int64.Type}, {\"SIFRA_EMISIJE\", type text}, {\"DATUM\", type date}, {\"VREME_POCETKA\", type time}, {\"TRAJANJE_TERMINA\", Int64.Type}, {\"TIP_TERMINA\", type text}, {\"ZONA_GLEDANOSTI\", type text}, {\"STATUS_TERMINA\", type text}, {\"REDNI_BROJ_REPRIZE\", Int64.Type}},",
          "        EMISIJA = {{\"SIFRA_EMISIJE\", type text}, {\"NAZIV_EMISIJE\", type text}, {\"ZANR\", type text}, {\"FORMAT_EMISIJE\", type text}, {\"PREDVIDJENO_TRAJANJE\", Int64.Type}, {\"CILJNA_PUBLIKA\", type text}, {\"STATUS_EMISIJE\", type text}, {\"PROGRAMSKI_ELABORAT\", type text}},",
          "        MEDIJSKI_SADRZAJ = {{\"SIFRA_SADRZAJA\", type text}, {\"NAZIV_SADRZAJA\", type text}, {\"TRAJANJE\", Int64.Type}, {\"FORMAT_ZAPISA\", type text}, {\"DATUM_ARHIVIRANJA\", type date}, {\"LOKACIJA_U_ARHIVI\", type text}},",
          "        POKRIVENOST_PRAVOM = {{\"BROJ_LICENCE\", type text}, {\"SIFRA_SADRZAJA\", type text}, {\"OBLAST_POKRIVENOSTI\", type text}},",
          "        PRAVO_KORISCENJA = {{\"BROJ_LICENCE\", type text}, {\"VRSTA_PRAVA\", type text}, {\"DATUM_OD\", type date}, {\"DATUM_DO\", type date}, {\"DOZVOLJENO_EMITOVANJA\", Int64.Type}, {\"ISKORISCENO_EMITOVANJA\", Int64.Type}, {\"TERITORIJA\", type text}, {\"NOSILAC_PRAVA\", type text}},",
          "        MERENJE_EMISIJE = {{\"SIFRA_MERENJA\", type text}, {\"SIFRA_EMISIJE\", type text}, {\"OSTVARENI_RATING\", type number}, {\"UDEO_U_TERMINU\", type number}},",
          "        MERENJE_GLEDANOSTI = {{\"SIFRA_MERENJA\", type text}, {\"DATUM_MERENJA\", type date}, {\"IZVOR_MERENJA\", type text}, {\"CILJNA_GRUPA\", type text}, {\"RATING\", type number}, {\"SHARE_UDEO\", type number}, {\"BROJ_GLEDALACA\", Int64.Type}, {\"PROSECNO_GLEDANJE\", Int64.Type}},",
          "        PROJEKAT_PRODUKCIJE = {{\"SIFRA_PROJEKTA\", type text}, {\"SIFRA_UREDNIKA\", type text}, {\"SIFRA_EMISIJE\", type text}, {\"NAZIV_PROJEKTA\", type text}, {\"DATUM_POCETKA\", type date}, {\"DATUM_ZAVRSETKA\", type date}, {\"ODOBREN_BUDZET\", Currency.Type}, {\"STATUS_PROJEKTA\", type text}, {\"VRSTA_PRODUKCIJE\", type text}, {\"OPIS_PROJEKTA\", type text}},",
          "        AKTIVNOST_PRODUKCIJE = {{\"SIFRA_PROJEKTA\", type text}, {\"RB_AKTIVNOSTI\", Int64.Type}, {\"NAZIV_AKTIVNOSTI\", type text}, {\"DATUM_OD\", type date}, {\"DATUM_DO\", type date}, {\"VRSTA_AKTIVNOSTI\", type text}, {\"LOKACIJA_SNIMANJA\", type text}, {\"STATUS_AKTIVNOSTI\", type text}},",
          "        TROSAK_PRODUKCIJE = {{\"SIFRA_PROJEKTA\", type text}, {\"RB_AKTIVNOSTI\", Int64.Type}, {\"RB_TROSKA\", Int64.Type}, {\"BROJ_FAKTURE\", type text}, {\"VRSTA_TROSKA\", type text}, {\"IZNOS\", Currency.Type}, {\"DATUM_NASTANKA\", type date}, {\"OPIS_TROSKA\", type text}},",
          "        FAKTURA = {{\"BROJ_FAKTURE\", type text}, {\"BROJ_UGOVORA\", type text}, {\"DATUM_IZDAVANJA\", type date}, {\"ROK_PLACANJA\", type date}, {\"SMER\", type text}, {\"OSNOVICA\", Currency.Type}, {\"IZNOS_PDV\", Currency.Type}, {\"STATUS_PLACANJA\", type text}, {\"IZNOS_ZA_PLACANJE\", Currency.Type}},",
          "        ZAPOSLENI = {{\"SIFRA_ZAPOSLENOG\", type text}, {\"SIFRA_JEDINICE\", type text}, {\"JMBG\", type text}, {\"IME\", type text}, {\"PREZIME\", type text}, {\"RADNO_MESTO\", type text}, {\"DATUM_ZAPOSLENJA\", type date}, {\"OSNOVNA_ZARADA\", Currency.Type}, {\"STATUS_ZAPOSLENJA\", type text}},",
          "        KLIJENT = {{\"SIFRA_KLIJENTA\", type text}, {\"NAZIV_KLIJENTA\", type text}, {\"PIB\", type text}, {\"MATICNI_BROJ\", type text}, {\"ULICA_I_BROJ\", type text}, {\"GRAD\", type text}, {\"POSTANSKI_BROJ\", type text}, {\"KONTAKT_OSOBA\", type text}},",
          "        OGLASIVAC = {{\"SIFRA_KLIJENTA\", type text}, {\"BRANSA\", type text}, {\"GODISNJI_BUDZET\", Currency.Type}},",
          "        UGOVOR = {{\"BROJ_UGOVORA\", type text}, {\"SIFRA_KLIJENTA\", type text}, {\"DATUM_SKLAPANJA\", type date}, {\"VAZI_OD\", type date}, {\"VAZI_DO\", type date}, {\"UKUPNA_VREDNOST\", Currency.Type}, {\"STATUS_UGOVORA\", type text}},",
          "        UGOVOR_O_OGLASAVANJU = {{\"BROJ_UGOVORA\", type text}, {\"UGOVORENI_TERMINI\", type text}},",
          "        STAVKA_UGOVORA = {{\"BROJ_UGOVORA\", type text}, {\"RB_STAVKE\", Int64.Type}, {\"OPIS_STAVKE\", type text}, {\"KOLICINA_SEKUNDE\", Int64.Type}, {\"JEDINICNA_CENA\", Currency.Type}, {\"POPUST\", type number}, {\"VREDNOST_STAVKE\", Currency.Type}},",
          "        EMITOVANJE_REKLAME = {{\"SIFRA_BLOKA\", type text}, {\"RB_U_BLOKU\", Int64.Type}, {\"SIFRA_SADRZAJA\", type text}, {\"BROJ_UGOVORA\", type text}, {\"RB_STAVKE_UGOVORA\", Int64.Type}, {\"DATUM_EMITOVANJA\", type date}, {\"VREME_EMITOVANJA\", type time}, {\"TRAJANJE_SPOTA\", Int64.Type}, {\"NAPLACENI_IZNOS\", Currency.Type}, {\"STATUS_NAPLATE\", type text}},",
          "        REKLAMNI_BLOK = {{\"SIFRA_BLOKA\", type text}, {\"SIFRA_TERMINA\", type text}, {\"SIFRA_CENOVNIKA\", type text}, {\"DATUM\", type date}, {\"VREME_POCETKA\", type time}, {\"TRAJANJE_BLOKA\", Int64.Type}, {\"ZAKUPLJENO_SEKUNDI\", Int64.Type}, {\"SLOBODNO_SEKUNDI\", Int64.Type}, {\"ISKORISCENOST\", type number}, {\"STATUS_BLOKA\", type text}},",
          "        CENOVNIK_REKL_TERMINA = {{\"SIFRA_CENOVNIKA\", type text}, {\"VAZI_OD\", type date}, {\"VAZI_DO\", type date}, {\"ZONA\", type text}, {\"CENA_PO_SEKUNDI\", Currency.Type}, {\"TIP_CENOVNOG_PAKETA\", type text}, {\"OPIS_CENOVNOG_PAKETA\", type text}},",
          "        PLAN_NABAVKE = {{\"SIFRA_PLANA\", type text}, {\"GODINA_PLANA\", Int64.Type}, {\"DATUM_DONOSENJA\", type date}, {\"STATUS_PLANA\", type text}, {\"UKUPNA_VREDNOST\", Currency.Type}, {\"DONOSILAC_PLANA\", type text}},",
          "        STAVKA_PLANA_NABAVKE = {{\"SIFRA_PLANA\", type text}, {\"RB_STAVKE\", Int64.Type}, {\"OPIS_ARTIKLA\", type text}, {\"KOLICINA\", Int64.Type}, {\"JEDINICA_MERE\", type text}, {\"PROCENJENA_CENA\", Currency.Type}, {\"PLANIRANI_KVARTAL\", type text}},",
          "        ZAHTEV_ZA_NABAVKU = {{\"BROJ_ZAHTEVA\", type text}, {\"SIFRA_JEDINICE\", type text}, {\"SIFRA_PLANA\", type text}, {\"DATUM_ZAHTEVA\", type date}, {\"VRSTA_NABAVKE\", type text}, {\"PREDMET_ZAHTEVA\", type text}, {\"OBRAZLOZENJE\", type text}, {\"STATUS_ZAHTEVA\", type text}, {\"PRIORITET\", type text}, {\"PROCENJENA_VREDNOST\", Currency.Type}},",
          "        PONUDA_DOBAVLJACA = {{\"BROJ_PONUDE\", type text}, {\"SIFRA_DOBAVLJACA\", type text}, {\"DATUM_PRIJEMA\", type date}, {\"VAZI_DO\", type date}, {\"UKUPNA_CENA\", Currency.Type}, {\"ROK_ISPORUKE\", type date}, {\"USLOVI_PLACANJA\", type text}, {\"STATUS_PONUDE\", type text}, {\"UKUPNO_BODOVA\", type number}},",
          "        PONUDJENA_STAVKA = {{\"SIFRA_PLANA\", type text}, {\"RB_STAVKE\", Int64.Type}, {\"BROJ_PONUDE\", type text}, {\"PONUDJENA_CENA\", Currency.Type}, {\"ROK_ZA_STAVKU\", type date}},",
          "        OCENA_PONUDE = {{\"BROJ_PONUDE\", type text}, {\"SIFRA_KRITERIJUMA\", type text}, {\"BROJ_BODOVA\", type number}, {\"KOMENTAR_OCENE\", type text}},",
          "        KRITERIJUM_VREDNOVANJA = {{\"SIFRA_KRITERIJUMA\", type text}, {\"NAZIV_KRITERIJUMA\", type text}, {\"NACIN_BODOVANJA\", type text}, {\"OPIS_KRITERIJUMA\", type text}},",
          "        DOBAVLJAC = {{\"SIFRA_DOBAVLJACA\", type text}, {\"NAZIV_DOBAVLJACA\", type text}, {\"PIB\", type text}, {\"MATICNI_BROJ\", type text}, {\"ADRESA\", type text}, {\"OCENA_DOBAVLJACA\", type number}},",
          "        NARUDZBENICA = {{\"BROJ_NARUDZBENICE\", type text}, {\"SIFRA_DOBAVLJACA\", type text}, {\"DATUM_IZDAVANJA\", type date}, {\"ROK_ISPORUKE\", type date}, {\"MESTO_ISPORUKE\", type text}, {\"UKUPAN_IZNOS\", Currency.Type}, {\"STATUS_NARUDZBINE\", type text}}",
          "    ]",
          "in",
          "    Tipovi"
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Record"
          }
        ]
      },
      {
        "name": "Tabela",
        "kind": "m",
        "expression": [
          "// Čita jednu tabelu iz Access baze ili iz CSV izvoza i postavlja tipove.",
          "(ime as text) as table =>",
          "let",
          "    sirovo =",
          "        if Izvor = \"CSV\" then",
          "            Table.PromoteHeaders(",
          "                Csv.Document(File.Contents(PutDoCsv & \"\\\" & ime & \".csv\"),",
          "                    [Delimiter=\";\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
          "                [PromoteAllScalars=true])",
          "        else",
          "            Access.Database(File.Contents(PutDoBaze),",
          "                [CreateNavigationProperties=false]){[Name=ime]}[Data],",
          "    trazeni = Record.FieldOrDefault(Tipovi, ime, {}),",
          "    postojeci = Table.ColumnNames(sirovo),",
          "    primenjivi = List.Select(trazeni, each List.Contains(postojeci, _{0})),",
          "    rez = if List.IsEmpty(primenjivi) then sirovo",
          "          else Table.TransformColumnTypes(sirovo, primenjivi, \"en-US\")",
          "in",
          "    rez"
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Izvor\", \"PutDoBaze\", \"PutDoCsv\", \"Tipovi\", \"Tabela\", \"Kalendar\", \"Emisije\", \"Projekti\", \"Ugovori\", \"Planovi\", \"Dobavljaci\", \"Playout\", \"Gledanost\", \"Troskovi\", \"StavkeUgovora\", \"EmitovanjaReklama\", \"StavkePlana\", \"VrednovanjePonuda\"]"
      },
      {
        "name": "PBI_ProTooling",
        "value": "[\"DevMode\"]"
      }
    ]
  }
}
