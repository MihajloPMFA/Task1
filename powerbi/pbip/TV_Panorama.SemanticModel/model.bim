            "summarizeBy": "none",
            "formatString": "hh:nn:ss"
          },
          {
            "name": "Šifra emisije",
            "dataType": "string",
            "sourceColumn": "Šifra emisije",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Medijski sadržaj",
            "dataType": "string",
            "sourceColumn": "Medijski sadržaj",
            "summarizeBy": "none"
          },
          {
            "name": "Format zapisa",
            "dataType": "string",
