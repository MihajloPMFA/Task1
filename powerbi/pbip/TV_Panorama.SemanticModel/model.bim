            "summarizeBy": "none"
          },
          {
            "name": "Planirano trajanje",
            "dataType": "int64",
            "sourceColumn": "Planirano trajanje",
            "summarizeBy": "sum",
            "formatString": "#,##0"
          },
          {
            "name": "Stvarno trajanje",
            "dataType": "int64",
            "sourceColumn": "Stvarno trajanje",
            "summarizeBy": "sum",
            "formatString": "#,##0"
          },
          {
            "name": "Odstupanje",
            "dataType": "int64",
            "sourceColumn": "Odstupanje",
            "summarizeBy": "sum",
            "formatString": "#,##0"
          },
          {
            "name": "Status realizacije",
            "dataType": "string",
            "sourceColumn": "Status realizacije",
            "summarizeBy": "none"
          },
          {
            "name": "Broj licence",
            "dataType": "string",
            "sourceColumn": "Broj licence",
            "summarizeBy": "none"
          },
          {
            "name": "Vrsta prava",
            "dataType": "string",
            "sourceColumn": "Vrsta prava",
            "summarizeBy": "none"
          },
          {
