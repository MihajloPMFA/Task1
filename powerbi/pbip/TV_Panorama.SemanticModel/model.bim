          },
          {
            "name": "Opis troška",
            "dataType": "string",
            "sourceColumn": "Opis troška",
            "summarizeBy": "none"
          },
          {
            "name": "Datum nastanka",
            "dataType": "dateTime",
            "sourceColumn": "Datum nastanka",
            "summarizeBy": "none"
          },
          {
            "name": "Iznos",
            "dataType": "decimal",
            "sourceColumn": "Iznos",
            "summarizeBy": "sum",
            "formatString": "#,##0.00"
          },
          {
            "name": "Broj fakture",
            "dataType": "string",
            "sourceColumn": "Broj fakture",
            "summarizeBy": "none"
          },
          {
            "name": "Status plaćanja",
            "dataType": "string",
            "sourceColumn": "Status plaćanja",
            "summarizeBy": "none"
          },
          {
            "name": "Ključ aktivnosti",
            "dataType": "string",
            "sourceColumn": "Ključ aktivnosti",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Troskovi",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    TP = Tabela(\"TROSAK_PRODUKCIJE\"),",
                "    AP = Tabela(\"AKTIVNOST_PRODUKCIJE\"),",
                "    F = Tabela(\"FAKTURA\"),",
                "    S1 = Table.NestedJoin(TP, {\"SIFRA_PROJEKTA\", \"RB_AKTIVNOSTI\"}, AP,",
                "        {\"SIFRA_PROJEKTA\", \"RB_AKTIVNOSTI\"}, \"ap\", JoinKind.Inner),",
                "    S2 = Table.ExpandTableColumn(S1, \"ap\", {\"NAZIV_AKTIVNOSTI\",",
                "        \"VRSTA_AKTIVNOSTI\", \"LOKACIJA_SNIMANJA\", \"STATUS_AKTIVNOSTI\",",
                "        \"DATUM_OD\", \"DATUM_DO\"}),",
                "    S3 = Table.NestedJoin(S2, {\"BROJ_FAKTURE\"}, F, {\"BROJ_FAKTURE\"},",
                "        \"f\", JoinKind.LeftOuter),",
                "    S4 = Table.ExpandTableColumn(S3, \"f\", {\"STATUS_PLACANJA\"}),",
                "    S5 = Table.AddColumn(S4, \"KLJUC_AKTIVNOSTI\",",
                "        each [SIFRA_PROJEKTA] & \"-\" &",
                "            Text.PadStart(Text.From([RB_AKTIVNOSTI]), 3, \"0\"), type text),",
                "    Odabir = Table.SelectColumns(S5, {\"SIFRA_PROJEKTA\", \"RB_AKTIVNOSTI\", \"NAZIV_AKTIVNOSTI\", \"VRSTA_AKTIVNOSTI\", \"LOKACIJA_SNIMANJA\", \"STATUS_AKTIVNOSTI\", \"DATUM_OD\", \"DATUM_DO\", \"RB_TROSKA\", \"VRSTA_TROSKA\", \"OPIS_TROSKA\", \"DATUM_NASTANKA\", \"IZNOS\", \"BROJ_FAKTURE\", \"STATUS_PLACANJA\", \"KLJUC_AKTIVNOSTI\"}),",
                "    Izlaz = Table.RenameColumns(Odabir, {{\"SIFRA_PROJEKTA\", \"Šifra projekta\"}, {\"RB_AKTIVNOSTI\", \"Rb aktivnosti\"}, {\"NAZIV_AKTIVNOSTI\", \"Aktivnost\"}, {\"VRSTA_AKTIVNOSTI\", \"Vrsta aktivnosti\"}, {\"LOKACIJA_SNIMANJA\", \"Lokacija snimanja\"}, {\"STATUS_AKTIVNOSTI\", \"Status aktivnosti\"}, {\"DATUM_OD\", \"Aktivnost od\"}, {\"DATUM_DO\", \"Aktivnost do\"}, {\"RB_TROSKA\", \"Rb troška\"}, {\"VRSTA_TROSKA\", \"Vrsta troška\"}, {\"OPIS_TROSKA\", \"Opis troška\"}, {\"DATUM_NASTANKA\", \"Datum nastanka\"}, {\"IZNOS\", \"Iznos\"}, {\"BROJ_FAKTURE\", \"Broj fakture\"}, {\"STATUS_PLACANJA\", \"Status plaćanja\"}, {\"KLJUC_AKTIVNOSTI\", \"Ključ aktivnosti\"}})",
                "in",
                "    Izlaz"
              ]
            }
          }
        ],
        "description": "Izveštaj 4: troškovi po aktivnostima projekata produkcije.",
        "measures": [
          {
            "name": "Ukupno troškova",
            "expression": [
              "SUM(Troskovi[Iznos])"
            ],
            "displayFolder": "Mere",
            "formatString": "#,##0.00"
          },
          {
            "name": "Broj troškova",
            "expression": [
              "COUNTROWS(Troskovi)"
            ],
            "displayFolder": "Mere",
            "formatString": "#,##0"
          },
          {
            "name": "Broj aktivnosti",
            "expression": [
              "DISTINCTCOUNT(Troskovi[Ključ aktivnosti])"
            ],
            "displayFolder": "Mere",
            "formatString": "#,##0"
          },
          {
            "name": "Prosečan trošak",
            "expression": [
              "AVERAGE(Troskovi[Iznos])"
            ],
            "displayFolder": "Mere",
            "formatString": "#,##0.00"
          }
        ]
      },
      {
