{
  "name": "TV_Panorama.SemanticModel",
  "compatibilityLevel": 1550,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "Kalendar",
        "columns": [
          {
            "name": "Datum",
            "dataType": "dateTime",
            "sourceColumn": "Datum",
            "summarizeBy": "none",
            "isKey": true
          },
          {
            "name": "Godina",
            "dataType": "int64",
            "sourceColumn": "Godina",
            "summarizeBy": "none"
          },
          {
            "name": "Kvartal",
            "dataType": "string",
            "sourceColumn": "Kvartal",
            "summarizeBy": "none"
          },
          {
            "name": "Mesec",
            "dataType": "int64",
            "sourceColumn": "Mesec",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Naziv meseca",
            "dataType": "string",
            "sourceColumn": "Naziv meseca",
            "summarizeBy": "none"
          },
          {
            "name": "Godina-mesec",
            "dataType": "string",
            "sourceColumn": "Godina-mesec",
            "summarizeBy": "none"
          },
          {
            "name": "Dan",
            "dataType": "int64",
            "sourceColumn": "Dan",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Naziv dana",
            "dataType": "string",
            "sourceColumn": "Naziv dana",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Kalendar",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Od = #date(2025, 1, 1),",
                "    Do = #date(2028, 12, 31),",
                "    Meseci = {\"januar\", \"februar\", \"mart\", \"april\", \"maj\", \"jun\", \"jul\",",
                "        \"avgust\", \"septembar\", \"oktobar\", \"novembar\", \"decembar\"},",
                "    ImenaDana = {\"ponedeljak\", \"utorak\", \"sreda\", \"četvrtak\", \"petak\",",
                "        \"subota\", \"nedelja\"},",
                "    Lista = List.Dates(Od, Duration.Days(Do - Od) + 1, #duration(1, 0, 0, 0)),",
                "    Osnov = Table.TransformColumnTypes(",
                "        Table.FromList(Lista, Splitter.SplitByNothing(), {\"Datum\"}),",
                "        {{\"Datum\", type date}}),",
                "    K1 = Table.AddColumn(Osnov, \"Godina\", each Date.Year([Datum]), Int64.Type),",
                "    K2 = Table.AddColumn(K1, \"Kvartal\",",
                "        each \"Q\" & Text.From(Date.QuarterOfYear([Datum])), type text),",
                "    K3 = Table.AddColumn(K2, \"Mesec\", each Date.Month([Datum]), Int64.Type),",
                "    K4 = Table.AddColumn(K3, \"Naziv meseca\",",
                "        each Meseci{Date.Month([Datum]) - 1}, type text),",
                "    K5 = Table.AddColumn(K4, \"Godina-mesec\",",
                "        each Text.From(Date.Year([Datum])) & \"-\" &",
                "            Text.PadStart(Text.From(Date.Month([Datum])), 2, \"0\"), type text),",
                "    K6 = Table.AddColumn(K5, \"Dan\", each Date.Day([Datum]), Int64.Type),",
                "    K7 = Table.AddColumn(K6, \"Naziv dana\",",
                "        each ImenaDana{Date.DayOfWeek([Datum], Day.Monday)}, type text)",
                "in",
                "    K7"
              ]
            }
          }
        ],
        "description": "Dimenzija datuma (2025-2028).",
        "dataCategory": "Time"
      },
      {
        "name": "Emisije",
        "columns": [
          {
            "name": "Šifra emisije",
            "dataType": "string",
            "sourceColumn": "Šifra emisije",
            "summarizeBy": "none"
          },
          {
            "name": "Naziv emisije",
            "dataType": "string",
            "sourceColumn": "Naziv emisije",
            "summarizeBy": "none"
          },
          {
            "name": "Žanr",
            "dataType": "string",
            "sourceColumn": "Žanr",
            "summarizeBy": "none"
          },
          {
            "name": "Format emisije",
            "dataType": "string",
            "sourceColumn": "Format emisije",
            "summarizeBy": "none"
          },
          {
            "name": "Predviđeno trajanje",
            "dataType": "int64",
            "sourceColumn": "Predviđeno trajanje",
            "summarizeBy": "sum",
            "formatString": "#,##0"
          },
          {
            "name": "Ciljna publika",
            "dataType": "string",
            "sourceColumn": "Ciljna publika",
            "summarizeBy": "none"
          },
          {
            "name": "Status emisije",
            "dataType": "string",
            "sourceColumn": "Status emisije",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Emisije",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Osnov = Tabela(\"EMISIJA\"),",
                "    Odabir = Table.SelectColumns(Osnov, {\"SIFRA_EMISIJE\", \"NAZIV_EMISIJE\", \"ZANR\", \"FORMAT_EMISIJE\", \"PREDVIDJENO_TRAJANJE\", \"CILJNA_PUBLIKA\", \"STATUS_EMISIJE\"}),",
                "    Izlaz = Table.RenameColumns(Odabir, {{\"SIFRA_EMISIJE\", \"Šifra emisije\"}, {\"NAZIV_EMISIJE\", \"Naziv emisije\"}, {\"ZANR\", \"Žanr\"}, {\"FORMAT_EMISIJE\", \"Format emisije\"}, {\"PREDVIDJENO_TRAJANJE\", \"Predviđeno trajanje\"}, {\"CILJNA_PUBLIKA\", \"Ciljna publika\"}, {\"STATUS_EMISIJE\", \"Status emisije\"}})",
                "in",
                "    Izlaz"
              ]
            }
          }
        ],
        "description": "Dimenzija: emisije iz programske šeme."
      },
      {
        "name": "Projekti",
        "columns": [
          {
            "name": "Šifra projekta",
            "dataType": "string",
            "sourceColumn": "Šifra projekta",
            "summarizeBy": "none"
          },
          {
            "name": "Naziv projekta",
            "dataType": "string",
            "sourceColumn": "Naziv projekta",
            "summarizeBy": "none"
          },
          {
            "name": "Vrsta produkcije",
            "dataType": "string",
            "sourceColumn": "Vrsta produkcije",
            "summarizeBy": "none"
          },
          {
            "name": "Status projekta",
            "dataType": "string",
            "sourceColumn": "Status projekta",
            "summarizeBy": "none"
          },
          {
            "name": "Datum početka",
            "dataType": "dateTime",
            "sourceColumn": "Datum početka",
            "summarizeBy": "none"
          },
          {
            "name": "Datum završetka",
            "dataType": "dateTime",
            "sourceColumn": "Datum završetka",
            "summarizeBy": "none"
          },
          {
            "name": "Odobren budžet",
            "dataType": "decimal",
            "sourceColumn": "Odobren budžet",
            "summarizeBy": "sum",
            "formatString": "#,##0.00"
          },
          {
            "name": "Urednik",
            "dataType": "string",
            "sourceColumn": "Urednik",
            "summarizeBy": "none"
          },
          {
            "name": "Emisija",
            "dataType": "string",
            "sourceColumn": "Emisija",
            "summarizeBy": "none"
          },
          {
            "name": "Opis projekta",
            "dataType": "string",
            "sourceColumn": "Opis projekta",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Projekti",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    P = Tabela(\"PROJEKAT_PRODUKCIJE\"),",
                "    Z = Tabela(\"ZAPOSLENI\"),",
                "    E = Tabela(\"EMISIJA\"),",
                "    S1 = Table.NestedJoin(P, {\"SIFRA_UREDNIKA\"}, Z, {\"SIFRA_ZAPOSLENOG\"},",
                "        \"z\", JoinKind.LeftOuter),",
                "    S2 = Table.ExpandTableColumn(S1, \"z\", {\"IME\", \"PREZIME\"},",
                "        {\"IME_U\", \"PREZIME_U\"}),",
                "    S3 = Table.AddColumn(S2, \"UREDNIK\",",
                "        each [PREZIME_U] & \" \" & [IME_U], type text),",
                "    S4 = Table.NestedJoin(S3, {\"SIFRA_EMISIJE\"}, E, {\"SIFRA_EMISIJE\"},",
                "        \"e\", JoinKind.LeftOuter),",
                "    S5 = Table.ExpandTableColumn(S4, \"e\", {\"NAZIV_EMISIJE\"}),",
                "    Odabir = Table.SelectColumns(S5, {\"SIFRA_PROJEKTA\", \"NAZIV_PROJEKTA\", \"VRSTA_PRODUKCIJE\", \"STATUS_PROJEKTA\", \"DATUM_POCETKA\", \"DATUM_ZAVRSETKA\", \"ODOBREN_BUDZET\", \"UREDNIK\", \"NAZIV_EMISIJE\", \"OPIS_PROJEKTA\"}),",
                "    Izlaz = Table.RenameColumns(Odabir, {{\"SIFRA_PROJEKTA\", \"Šifra projekta\"}, {\"NAZIV_PROJEKTA\", \"Naziv projekta\"}, {\"VRSTA_PRODUKCIJE\", \"Vrsta produkcije\"}, {\"STATUS_PROJEKTA\", \"Status projekta\"}, {\"DATUM_POCETKA\", \"Datum početka\"}, {\"DATUM_ZAVRSETKA\", \"Datum završetka\"}, {\"ODOBREN_BUDZET\", \"Odobren budžet\"}, {\"UREDNIK\", \"Urednik\"}, {\"NAZIV_EMISIJE\", \"Emisija\"}, {\"OPIS_PROJEKTA\", \"Opis projekta\"}})",
                "in",
                "    Izlaz"
              ]
            }
          }
        ],
        "description": "Dimenzija: projekti produkcije sa odobrenim budžetom.",
        "measures": [
          {
            "name": "Odobren budžet (ukupno)",
            "expression": [
              "SUM(Projekti[Odobren budžet])"
            ],
            "displayFolder": "Mere",
            "formatString": "#,##0.00"
          },
          {
            "name": "% iskorišćenja budžeta",
            "expression": [
              "DIVIDE([Ukupno troškova], [Odobren budžet (ukupno)])"
            ],
            "displayFolder": "Mere",
            "formatString": "0.0%"
          }
        ]
      },
      {
        "name": "Ugovori",
        "columns": [
          {
            "name": "Broj ugovora",
            "dataType": "string",
            "sourceColumn": "Broj ugovora",
            "summarizeBy": "none"
          },
          {
            "name": "Šifra oglašivača",
            "dataType": "string",
            "sourceColumn": "Šifra oglašivača",
            "summarizeBy": "none"
          },
          {
            "name": "Oglašivač",
            "dataType": "string",
            "sourceColumn": "Oglašivač",
            "summarizeBy": "none"
          },
          {
            "name": "PIB",
            "dataType": "string",
            "sourceColumn": "PIB",
            "summarizeBy": "none"
          },
          {
            "name": "Kontakt osoba",
            "dataType": "string",
            "sourceColumn": "Kontakt osoba",
            "summarizeBy": "none"
          },
          {
            "name": "Grad",
            "dataType": "string",
            "sourceColumn": "Grad",
            "summarizeBy": "none"
          },
          {
            "name": "Branša",
            "dataType": "string",
            "sourceColumn": "Branša",
            "summarizeBy": "none"
          },
          {
            "name": "Godišnji budžet",
            "dataType": "decimal",
            "sourceColumn": "Godišnji budžet",
            "summarizeBy": "sum",
            "formatString": "#,##0.00"
          },
          {
            "name": "Datum sklapanja",
            "dataType": "dateTime",
            "sourceColumn": "Datum sklapanja",
            "summarizeBy": "none"
          },
          {
            "name": "Važi od",
            "dataType": "dateTime",
            "sourceColumn": "Važi od",
            "summarizeBy": "none"
          },
          {
            "name": "Važi do",
            "dataType": "dateTime",
            "sourceColumn": "Važi do",
            "summarizeBy": "none"
          },
          {
            "name": "Status ugovora",
            "dataType": "string",
            "sourceColumn": "Status ugovora",
            "summarizeBy": "none"
          },
          {
            "name": "Vrednost ugovora",
            "dataType": "decimal",
            "sourceColumn": "Vrednost ugovora",
            "summarizeBy": "sum",
            "formatString": "#,##0.00"
          },
          {
            "name": "Ugovoreni termini",
            "dataType": "string",
            "sourceColumn": "Ugovoreni termini",
            "summarizeBy": "none"
          },
          {
            "name": "Fakturisano (iznos)",
            "dataType": "decimal",
            "sourceColumn": "Fakturisano (iznos)",
            "summarizeBy": "sum",
            "formatString": "#,##0.00"
          },
          {
            "name": "Status fakture",
            "dataType": "string",
            "sourceColumn": "Status fakture",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Ugovori",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    U = Tabela(\"UGOVOR\"),",
                "    UO = Tabela(\"UGOVOR_O_OGLASAVANJU\"),",
                "    Kl = Tabela(\"KLIJENT\"),",
                "    OG = Tabela(\"OGLASIVAC\"),",
                "    F = Tabela(\"FAKTURA\"),",
                "    S1 = Table.NestedJoin(U, {\"BROJ_UGOVORA\"}, UO, {\"BROJ_UGOVORA\"},",
                "        \"uo\", JoinKind.Inner),",
                "    S2 = Table.ExpandTableColumn(S1, \"uo\", {\"UGOVORENI_TERMINI\"}),",
                "    S3 = Table.NestedJoin(S2, {\"SIFRA_KLIJENTA\"}, Kl, {\"SIFRA_KLIJENTA\"},",
                "        \"k\", JoinKind.Inner),",
                "    S4 = Table.ExpandTableColumn(S3, \"k\",",
                "        {\"NAZIV_KLIJENTA\", \"PIB\", \"KONTAKT_OSOBA\", \"GRAD\"}),",
                "    S5 = Table.NestedJoin(S4, {\"SIFRA_KLIJENTA\"}, OG, {\"SIFRA_KLIJENTA\"},",
                "        \"og\", JoinKind.Inner),",
                "    S6 = Table.ExpandTableColumn(S5, \"og\", {\"BRANSA\", \"GODISNJI_BUDZET\"}),",
                "    Fak = Table.Group(Table.SelectRows(F, each [BROJ_UGOVORA] <> null),",
                "        {\"BROJ_UGOVORA\"},",
                "        {{\"FAKTURISANO\", each List.Sum([IZNOS_ZA_PLACANJE]), Currency.Type},",
                "         {\"STATUS_FAKTURE\", each List.Min([STATUS_PLACANJA]), type text}}),",
                "    S7 = Table.NestedJoin(S6, {\"BROJ_UGOVORA\"}, Fak, {\"BROJ_UGOVORA\"},",
                "        \"f\", JoinKind.LeftOuter),",
                "    S8 = Table.ExpandTableColumn(S7, \"f\",",
                "        {\"FAKTURISANO\", \"STATUS_FAKTURE\"}),",
                "    Odabir = Table.SelectColumns(S8, {\"BROJ_UGOVORA\", \"SIFRA_KLIJENTA\", \"NAZIV_KLIJENTA\", \"PIB\", \"KONTAKT_OSOBA\", \"GRAD\", \"BRANSA\", \"GODISNJI_BUDZET\", \"DATUM_SKLAPANJA\", \"VAZI_OD\", \"VAZI_DO\", \"STATUS_UGOVORA\", \"UKUPNA_VREDNOST\", \"UGOVORENI_TERMINI\", \"FAKTURISANO\", \"STATUS_FAKTURE\"}),",
                "    Izlaz = Table.RenameColumns(Odabir, {{\"BROJ_UGOVORA\", \"Broj ugovora\"}, {\"SIFRA_KLIJENTA\", \"Šifra oglašivača\"}, {\"NAZIV_KLIJENTA\", \"Oglašivač\"}, {\"KONTAKT_OSOBA\", \"Kontakt osoba\"}, {\"GRAD\", \"Grad\"}, {\"BRANSA\", \"Branša\"}, {\"GODISNJI_BUDZET\", \"Godišnji budžet\"}, {\"DATUM_SKLAPANJA\", \"Datum sklapanja\"}, {\"VAZI_OD\", \"Važi od\"}, {\"VAZI_DO\", \"Važi do\"}, {\"STATUS_UGOVORA\", \"Status ugovora\"}, {\"UKUPNA_VREDNOST\", \"Vrednost ugovora\"}, {\"UGOVORENI_TERMINI\", \"Ugovoreni termini\"}, {\"FAKTURISANO\", \"Fakturisano (iznos)\"}, {\"STATUS_FAKTURE\", \"Status fakture\"}})",
                "in",
                "    Izlaz"
              ]
            }
          }
        ],
        "description": "Dimenzija: ugovori o oglašavanju sa podacima o oglašivaču.",
        "measures": [
          {
            "name": "Fakturisano",
            "expression": [
              "SUM(Ugovori[Fakturisano (iznos)])"
            ],
            "displayFolder": "Mere",
            "formatString": "#,##0.00"
          },
          {
            "name": "Broj ugovora (broj)",
            "expression": [
              "DISTINCTCOUNT(Ugovori[Broj ugovora])"
            ],
            "displayFolder": "Mere",
            "formatString": "#,##0"
          },
          {
            "name": "Razlika sekundi",
            "expression": [
              "[Ugovoreno sekundi] - [Realizovano sekundi]"
            ],
            "displayFolder": "Mere",
            "formatString": "#,##0"
          },
          {
            "name": "% realizacije sekundi",
            "expression": [
              "DIVIDE([Realizovano sekundi], [Ugovoreno sekundi])"
            ],
            "displayFolder": "Mere",
            "formatString": "0.0%"
          },
          {
            "name": "% naplate",
            "expression": [
              "DIVIDE([Naplaćeno], [Ugovorena vrednost])"
            ],
            "displayFolder": "Mere",
            "formatString": "0.0%"
          }
        ]
      },
      {
        "name": "Planovi",
        "columns": [
          {
            "name": "Šifra plana",
            "dataType": "string",
            "sourceColumn": "Šifra plana",
            "summarizeBy": "none"
          },
          {
            "name": "Godina plana",
