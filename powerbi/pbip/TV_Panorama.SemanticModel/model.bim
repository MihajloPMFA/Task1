            "dataType": "string",
            "sourceColumn": "Status aktivnosti",
            "summarizeBy": "none"
          },
          {
            "name": "Aktivnost od",
            "dataType": "dateTime",
            "sourceColumn": "Aktivnost od",
            "summarizeBy": "none"
          },
