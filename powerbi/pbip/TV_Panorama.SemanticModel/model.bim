            "sourceColumn": "Vrednost plana",
            "summarizeBy": "sum",
            "formatString": "#,##0.00"
          },
          {
            "name": "Broj zahteva",
            "dataType": "string",
            "sourceColumn": "Broj zahteva",
            "summarizeBy": "none"
          },
          {
            "name": "Datum zahteva",
            "dataType": "dateTime",
            "sourceColumn": "Datum zahteva",
            "summarizeBy": "none"
          },
          {
            "name": "Status zahteva",
            "dataType": "string",
            "sourceColumn": "Status zahteva",
            "summarizeBy": "none"
          },
          {
            "name": "Prioritet",
            "dataType": "string",
            "sourceColumn": "Prioritet",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Planovi",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    P = Tabela(\"PLAN_NABAVKE\"),",
                "    Z = Tabela(\"ZAHTEV_ZA_NABAVKU\"),",
                "    Z1 = Table.SelectRows(Z, each [SIFRA_PLANA] <> null),",
                "    Zg = Table.Group(Z1, {\"SIFRA_PLANA\"}, {{\"prvi\",",
                "        each Table.FirstN(Table.Sort(_,",
                "            {{\"BROJ_ZAHTEVA\", Order.Ascending}}), 1), type table}}),",
                "    Ze = Table.ExpandTableColumn(Zg, \"prvi\",",
                "        {\"BROJ_ZAHTEVA\", \"DATUM_ZAHTEVA\", \"STATUS_ZAHTEVA\", \"PRIORITET\"}),",
                "    S1 = Table.NestedJoin(P, {\"SIFRA_PLANA\"}, Ze, {\"SIFRA_PLANA\"},",
                "        \"z\", JoinKind.LeftOuter),",
                "    S2 = Table.ExpandTableColumn(S1, \"z\",",
                "        {\"BROJ_ZAHTEVA\", \"DATUM_ZAHTEVA\", \"STATUS_ZAHTEVA\", \"PRIORITET\"}),",
                "    Odabir = Table.SelectColumns(S2, {\"SIFRA_PLANA\", \"GODINA_PLANA\", \"DATUM_DONOSENJA\", \"STATUS_PLANA\", \"DONOSILAC_PLANA\", \"UKUPNA_VREDNOST\", \"BROJ_ZAHTEVA\", \"DATUM_ZAHTEVA\", \"STATUS_ZAHTEVA\", \"PRIORITET\"}),",
                "    Izlaz = Table.RenameColumns(Odabir, {{\"SIFRA_PLANA\", \"Šifra plana\"}, {\"GODINA_PLANA\", \"Godina plana\"}, {\"DATUM_DONOSENJA\", \"Datum donošenja\"}, {\"STATUS_PLANA\", \"Status plana\"}, {\"DONOSILAC_PLANA\", \"Donosilac plana\"}, {\"UKUPNA_VREDNOST\", \"Vrednost plana\"}, {\"BROJ_ZAHTEVA\", \"Broj zahteva\"}, {\"DATUM_ZAHTEVA\", \"Datum zahteva\"}, {\"STATUS_ZAHTEVA\", \"Status zahteva\"}, {\"PRIORITET\", \"Prioritet\"}})",
                "in",
                "    Izlaz"
              ]
            }
          }
        ],
        "description": "Dimenzija: planovi nabavke sa povezanim zahtevom."
      },
      {
        "name": "Dobavljaci",
        "columns": [
          {
            "name": "Šifra dobavljača",
            "dataType": "string",
            "sourceColumn": "Šifra dobavljača",
            "summarizeBy": "none"
          },
          {
            "name": "Naziv dobavljača",
            "dataType": "string",
            "sourceColumn": "Naziv dobavljača",
            "summarizeBy": "none"
          },
          {
            "name": "PIB",
            "dataType": "string",
            "sourceColumn": "PIB",
            "summarizeBy": "none"
          },
          {
            "name": "Adresa",
            "dataType": "string",
            "sourceColumn": "Adresa",
            "summarizeBy": "none"
          },
          {
            "name": "Ocena dobavljača",
            "dataType": "double",
            "sourceColumn": "Ocena dobavljača",
            "summarizeBy": "average",
            "formatString": "0.00"
          }
        ],
        "partitions": [
          {
            "name": "Dobavljaci",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Osnov = Tabela(\"DOBAVLJAC\"),",
                "    Odabir = Table.SelectColumns(Osnov, {\"SIFRA_DOBAVLJACA\", \"NAZIV_DOBAVLJACA\", \"PIB\", \"ADRESA\", \"OCENA_DOBAVLJACA\"}),",
                "    Izlaz = Table.RenameColumns(Odabir, {{\"SIFRA_DOBAVLJACA\", \"Šifra dobavljača\"}, {\"NAZIV_DOBAVLJACA\", \"Naziv dobavljača\"}, {\"ADRESA\", \"Adresa\"}, {\"OCENA_DOBAVLJACA\", \"Ocena dobavljača\"}})",
                "in",
                "    Izlaz"
              ]
            }
          }
        ],
        "description": "Dimenzija: dobavljači koji su dostavili ponude."
      },
      {
        "name": "Playout",
        "columns": [
          {
            "name": "Datum",
            "dataType": "dateTime",
            "sourceColumn": "Datum",
